# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FINGERPRINT_PEPPER: Secret high-entropy pepper stored outside the database on the server, used to securely compute HMAC signatures.
FINGERPRINT_PEPPER=""

# MAILCHIMP_API_KEY: Transactional API key used to deliver family invites and emergency release notes.
MAILCHIMP_API_KEY="a6d12a214167ac734ee42dbfbca655ca-us14"

# SMTP Configuration (Standard email dispatch for Gmail, Brevo, SendGrid, Amazon SES, or custom mail server)
# SMTP_HOST: The hostname of your SMTP server (e.g., smtp.gmail.com, smtp-relay.brevo.com, smtp.sendgrid.net)
SMTP_HOST=""

# SMTP_PORT: Port number (e.g., 587 for STARTTLS, 465 for SSL/TLS, or 25)
SMTP_PORT="587"

# SMTP_SECURE: Set to "true" for port 465 (SSL), or "false" for other ports (STARTTLS)
SMTP_SECURE="false"

# SMTP_USER: Username or email address for SMTP authentication (e.g., your-email@gmail.com)
SMTP_USER=""

# SMTP_PASS: Password or App Password for SMTP authentication (e.g., 16-character Google App Password)
SMTP_PASS=""

# SMTP_FROM: Sender email address and name (e.g., "WhyOr Vault <vault@yourdomain.com>")
SMTP_FROM=""

# VITE_APP_ENV: Application running environment ("Sandbox" or "Production"). If not set, defaults to "Production".
VITE_APP_ENV="Production"
