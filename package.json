    "crypto-browserify": "^3.12.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "events": "^3.3.0",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
